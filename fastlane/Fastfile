# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

output_directory = './fastlane/Test Output/'
coverage_directory = '/coverage'

require 'fileutils'

default_platform(:android)

def repo_root
  @repo_root ||= `git rev-parse --show-toplevel`.strip
end

def android_sdk_dir
  %w[ANDROID_HOME ANDROID_SDK_ROOT].each do |var|
    value = ENV[var].to_s
    return value unless value.empty?
  end

  properties = File.join(repo_root, "local.properties")
  if File.exist?(properties)
    entry = File.readlines(properties).find { |line| line.start_with?("sdk.dir=") }
    return entry.to_s.split("=", 2).last.to_s.strip
  end

  ""
end

def ensure_android_sdk_env
  sdk_dir = android_sdk_dir
  if sdk_dir.empty?
    UI.user_error!(
      "Android SDK not found. Set ANDROID_HOME (CI images normally do), or add " \
      "sdk.dir=/path/to/sdk to local.properties."
    )
  end
  ENV["ANDROID_HOME"] = sdk_dir

  tools_bin = File.join(sdk_dir, "cmdline-tools", "latest", "bin")
  unless File.directory?(tools_bin)
    UI.important(
      "cmdline-tools not found at #{tools_bin}. apkscale invokes apkanalyzer from " \
      "there; install it with: sdkmanager --install \"cmdline-tools;latest\""
    )
    return
  end

  entries = ENV["PATH"].to_s.split(File::PATH_SEPARATOR)
  ENV["PATH"] = ([tools_bin] + entries).join(File::PATH_SEPARATOR) unless entries.include?(tools_bin)
  UI.message("Android SDK: #{sdk_dir} (apkanalyzer available for apkscale)")
end

platform :android do

  desc "Decrypt the sample app's google-services.json"
  lane :decrypt_google_services do
    key = ENV.fetch("GOOGLE_SERVICES_KEY")
    iv = ENV.fetch("GOOGLE_SERVICES_IV")
    # log: false -- the command line carries the key and IV.
    sh("cd ../sample && ./add_google_services_file #{key} #{iv}", log: false)
  end

  desc "Assemble build"
  lane :assemble do
    gradle(
      tasks: ["assembleDebug", "assembleDebugAndroidTest", ":security:assembleDebugAndroidTest"]
    )
  end
  
  desc "Runs all the tests with coverage"
  lane :unit_tests do
    gradle(
      tasks: [
        ":verify:koverXmlReportDebug", ":verify:koverVerify",
        ":security:koverXmlReportDebug", ":security:koverVerify",
        ":sample:testDebugUnitTest"
      ]
    )
  end

  desc "Size impact report"
  lane :sdk_sizer do
    ensure_android_sdk_env
    gradle(task: "generateSizeReport", flags: "--no-daemon")
  end

  desc "Check android, kotlin style convention"
  lane :lint_checker do
    gradle(
      tasks: ["ktlintCheck"]
    )
  end

  desc "Materialize the GPG signing keyring from the base64-encoded SIGNING_KEY"
  lane :install_signing_key do
    key = ENV.fetch("SIGNING_KEY")
    path = ENV.fetch("SIGNING_SECRET_KEY_RING_FILE")
    FileUtils.mkdir_p(File.dirname(path))
    # Overwrite rather than append: appending corrupts the keyring on a re-run.
    File.binwrite(path, key.unpack1("m"))
  end

  desc "Release a new production version"
  lane :release do
    title = 'Android Verify Push Release'
    tag_prefix = '*'
    next unless verify(title: title, tag_prefix: tag_prefix)
    increment_version()
    UI.message("Releasing to MavenCentral")
    gradle(task: "sonatypeTwilioVerifyReleaseUpload")
    latest_docs()
    post_release()
  end

  desc "Verify next release"
  lane :verify do |options|
    if !is_ci? then
      UI.message("#{options[:title]} deploy was triggered on local machine")
      gradle(task: "clean")
    else
      UI.message("#{options[:title]} deploy was triggered on CI")
    end

    # Check if there is any change since last version
    is_releaseable = analyze_commits(
      match: options[:tag_prefix]
    )
    unless is_releaseable
      UI.important("Skip deploying #{options[:title]}. No changes since last one!")
    end
    is_releaseable
  end

  desc "Generates latest API doc"
  lane :latest_docs do
    next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]
    UI.message("Generating the API docs for version #{next_version}")
    gradle(task: ":verify:generateVersionedDocs")
    sh("ln -nsf #{next_version} ../docs/latest")
  end

  desc "Increment version"
  lane :increment_version do |options|
    next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]
    ensure_git_status_clean(
      ignore_files: ["Gemfile.lock"]
    )
    # Increment version in Verify module
    UI.message("Updating verify/gradle.properties")
    gradle(task: "-q :verify:incrementVersion", properties: { 'version_number' => next_version })
  end

  desc "Generates release tag, release notes and updates CHANGELOG.md"
  lane :post_release do
    next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]
    notes = conventional_changelog(
      format: 'markdown',
      commit_url: 'https://github.com/twilio/twilio-verify-android/commit')
    tag = next_version
    UI.important(notes)

    UI.message("Updating CHANGELOG.md")
    sdk_size = sh("cat ../builds/sizeReport/TwilioVerifySizeImpactReport.txt")
    changelog = "#{notes}\\n\\n#{sdk_size}"
    sh("echo \"#{changelog}\\n\" | cat - ../CHANGELOG.md > temp && mv temp ../CHANGELOG.md")
    git_add(path: ["./verify/gradle.properties", "./CHANGELOG.md", "./docs/#{next_version}", "./docs/latest"])
    sh("git config user.name \"#{ENV["GH_USER_NAME"]}\"")
    sh("git config user.email \"#{ENV["GH_USER_EMAIL"]}\"")
    sh("git commit -m \"Version bump to #{next_version} [skip ci]\"")
    push_to_git_remote
    add_git_tag(tag: tag)
    push_git_tags(tag: tag)

    set_github_release(
      repository_name: "twilio/twilio-verify-android",
      api_token: ENV["GH_TOKEN"],
      name: tag,
      tag_name: tag,
      description: notes,
      commitish: "main"
    )
    gradle(task: "mavenLocalTwilioVerifyReleaseUpload")
    plain_notes = conventional_changelog(
            format: 'plain',
            commit_url: 'https://github.com/twilio/twilio-verify-android/commit')
    distribute_sample_app(notes: plain_notes, build_type: "Release", url: ENV["PROD_URL"], versionName: next_version)
  end

  desc "Danger check"
  lane :danger_check do
    danger(
      danger_id: 'Linter',
      dangerfile: 'Dangerfile',
      github_api_token: ENV["GH_TOKEN"],
      remove_previous_comments: true,
      fail_on_errors: true,
      verbose: true
    )
  end

  desc "Distribute sample app debug mode for internal testing"
  lane :distribute_debug_sample_app do |options|
   env = options[:env]
   title = "Android Verify Push #{env}"
   tag_prefix = '*'
   verify(title: title, tag_prefix: tag_prefix)
   next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]
   plain_notes = conventional_changelog(
            format: 'plain',
            commit_url: 'https://github.com/twilio/twilio-verify-android/commit')
   url = options[:url]
   distribute_sample_app(notes: plain_notes, build_type: "Debug", url: url, versionName: "#{next_version}-#{env}")
  end

  desc "Distribute sample app for internal testing"
  lane :distribute_sample_app do |options|
    app_distribution_key = "gcloud-app-distribution-service-key.json"
    key_file = "#{ENV["HOME"]}/#{app_distribution_key}"
    build_android_app(
      properties: {
        "baseURL" => options[:url],
        "verifyVersionName" => options[:versionName]
      },
      task: "assemble",
      build_type: options[:build_type],
      print_command: false
    )
    path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    firebase_app_distribution(
      app: ENV["SAMPLE_APP_FIREBASE_ID"],
      apk_path: path,
      groups: ENV["FIREBASE_APP_DISTRIBUTION_GROUP"],
      service_credentials_file: key_file,
      release_notes: options[:notes]
    )
  end
end
